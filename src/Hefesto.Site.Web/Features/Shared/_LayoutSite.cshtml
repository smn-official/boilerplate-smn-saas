<!DOCTYPE html>
<html lang="pt-BR" class="bg-fundo">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Hefesto</title>
    <meta name="description" content="@ViewData["Description"]" />
    <link rel="stylesheet" href="~/Features/Shared/Styles/app.css" />
</head>
<body class="bg-fundo font-sans text-texto antialiased">
    <a href="#conteudo"
       class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded-lg
              focus:bg-superficie focus:px-4 focus:py-2 focus:text-body-sm focus:text-texto
              focus:outline-2 focus:outline-offset-2 focus:outline-primaria">
        Pular para o conteúdo
    </a>

    <partial name="_CabecalhoSite" />

    <main id="conteudo">
        @RenderBody()
    </main>

    <partial name="_RodapeSite" />
</body>
</html>
