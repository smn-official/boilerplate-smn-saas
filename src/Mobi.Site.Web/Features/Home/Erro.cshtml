@{
    ViewData["Title"] = "Página não encontrada | Fiat Mobi";
    ViewData["Description"] = "A página que você procurou não está disponível.";
}

<section class="mx-auto w-full max-w-3xl px-4 py-20 text-center sm:px-6 lg:px-8">
    <h1 class="text-h1 text-texto md:text-display-md">Esta página saiu do ar</h1>
    <p class="mx-auto mt-4 max-w-lg text-body-lg text-texto-suave">
        O endereço mudou ou o link está quebrado. Volte para a página do Mobi para ver as versões
        e agendar seu test-drive.
    </p>
    <a href="/"
       class="mt-8 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-primaria px-5
              py-3 text-body-sm font-medium text-texto-invertido transition-colors
              hover:bg-primaria-hover focus-visible:outline-2 focus-visible:outline-offset-2
              focus-visible:outline-primaria sm:w-auto">
        <icon name="arrow-left" class="size-4" aria-hidden="true" />
        Voltar para o Fiat Mobi
    </a>
</section>
