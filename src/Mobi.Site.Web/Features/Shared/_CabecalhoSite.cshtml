<header class="sticky top-0 z-40 border-b border-borda bg-superficie/95 backdrop-blur">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between gap-4">
            <a href="#conteudo"
               class="flex shrink-0 items-center gap-2 rounded-lg
                      focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primaria">
                <icon name="car-front" class="size-6 text-primaria" aria-hidden="true" />
                <span class="text-h3 text-texto">Mobi</span>
            </a>

            <nav aria-label="Navegação principal" class="hidden items-center gap-8 md:flex">
                <a href="#versoes"
                   class="text-body-sm text-texto-suave transition-colors hover:text-texto
                          focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primaria">
                    Versões
                </a>
                <a href="#ficha"
                   class="text-body-sm text-texto-suave transition-colors hover:text-texto
                          focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primaria">
                    Ficha técnica
                </a>
                <a href="#perguntas"
                   class="text-body-sm text-texto-suave transition-colors hover:text-texto
                          focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primaria">
                    Dúvidas
                </a>
            </nav>

            <div class="hidden shrink-0 items-center gap-3 md:flex">
                <a href="tel:+554130000000"
                   class="text-body-sm font-medium text-texto transition-colors hover:text-primaria
                          focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primaria">
                    (41) 3000-0000
                </a>
                <a href="#agendar"
                   class="inline-flex items-center justify-center gap-2 rounded-lg bg-primaria px-4 py-2.5
                          text-body-sm font-medium text-texto-invertido transition-colors hover:bg-primaria-hover
                          focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primaria">
                    Agendar test-drive
                </a>
            </div>

            <details class="group relative md:hidden">
                <summary class="inline-flex size-11 cursor-pointer list-none items-center justify-center
                               rounded-lg text-texto-suave transition-colors hover:bg-borda/40 hover:text-texto
                               focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primaria
                               [&::-webkit-details-marker]:hidden"
                         aria-label="Abrir menu de navegação">
                    <icon name="menu" class="size-5 group-open:hidden" aria-hidden="true" />
                    <icon name="x" class="hidden size-5 group-open:block" aria-hidden="true" />
                </summary>

                <div class="absolute right-0 top-full mt-2 w-60 rounded-lg border border-borda bg-superficie
                            p-2 shadow-lg">
                    <a href="#versoes"
                       class="block rounded-lg px-3 py-3 text-body text-texto transition-colors
                              hover:bg-borda/40 focus-visible:outline-2 focus-visible:outline-offset-2
                              focus-visible:outline-primaria">
                        Versões
                    </a>
                    <a href="#ficha"
                       class="block rounded-lg px-3 py-3 text-body text-texto transition-colors
                              hover:bg-borda/40 focus-visible:outline-2 focus-visible:outline-offset-2
                              focus-visible:outline-primaria">
                        Ficha técnica
                    </a>
                    <a href="#perguntas"
                       class="block rounded-lg px-3 py-3 text-body text-texto transition-colors
                              hover:bg-borda/40 focus-visible:outline-2 focus-visible:outline-offset-2
                              focus-visible:outline-primaria">
                        Dúvidas
                    </a>

                    <div class="my-2 border-t border-borda"></div>

                    <a href="tel:+554130000000"
                       class="block rounded-lg px-3 py-3 text-body text-texto transition-colors
                              hover:bg-borda/40 focus-visible:outline-2 focus-visible:outline-offset-2
                              focus-visible:outline-primaria">
                        (41) 3000-0000
                    </a>
                    <a href="#agendar"
                       class="mt-1 flex items-center justify-center rounded-lg bg-primaria px-4 py-3
                              text-body-sm font-medium text-texto-invertido transition-colors
                              hover:bg-primaria-hover focus-visible:outline-2 focus-visible:outline-offset-2
                              focus-visible:outline-primaria">
                        Agendar test-drive
                    </a>
                </div>
            </details>
        </div>
    </div>
</header>
