@model ComponentViewModel
@{
    Layout = "_PanelLayout";
}

<div class="flex flex-col gap-6">
    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Horizontal</p>
        <p class="text-sm">Primeira seção do conteúdo.</p>
        <smn-separator class="my-4" />
        <p class="text-sm">Segunda seção, depois da divisão.</p>
    </div>

    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Contraste</p>
        <div class="flex flex-col gap-4">
            <div>
                <p class="mb-2 text-xs text-muted">Default</p>
                <smn-separator variant="Default" />
            </div>
            <div>
                <p class="mb-2 text-xs text-muted">Secondary</p>
                <smn-separator variant="Secondary" />
            </div>
            <div>
                <p class="mb-2 text-xs text-muted">Tertiary</p>
                <smn-separator variant="Tertiary" />
            </div>
        </div>
    </div>

    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Vertical</p>
        <div class="flex h-10 items-center gap-3">
            <span class="text-sm">Editar</span>
            <smn-separator orientation="Vertical" />
            <span class="text-sm">Duplicar</span>
            <smn-separator orientation="Vertical" />
            <span class="text-sm">Excluir</span>
        </div>
    </div>

    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Com conteúdo</p>
        <p class="mb-4 text-sm text-muted">
            Havendo conteúdo dentro da tag, a linha se parte em volta dele. É o
            <em>ou</em> entre o formulário e a alternativa.
        </p>
        <div class="flex flex-col gap-3">
            <smn-button variant="Primary" full-width="true">Entrar com e-mail</smn-button>
            <smn-separator class="text-xs">ou</smn-separator>
            <smn-button variant="Outline" full-width="true">Entrar com Google</smn-button>
        </div>
    </div>
</div>
