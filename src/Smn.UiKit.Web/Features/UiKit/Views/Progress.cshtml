@model ComponentViewModel
@{
    Layout = "_PanelLayout";
}

<div class="flex flex-col gap-6">
    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Progress bar</p>
        <div class="flex flex-col gap-5">
            <smn-progress-bar value="25" label="Enviando arquivos" show-value="true" />
            <smn-progress-bar value="60" label="Processando" show-value="true" color="Success" />
            <smn-progress-bar value="90" label="Quase lá" show-value="true" color="Warning" />
        </div>
    </div>

    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Indeterminado</p>
        <p class="mb-4 text-sm text-muted">
            Sem <code class="rounded bg-surface-secondary px-1.5 py-0.5 text-xs">value</code> a barra
            fica indeterminada — é a escolha certa quando não se sabe o total. Fingir uma porcentagem
            que não se conhece é pior que assumir que não se sabe.
        </p>
        <smn-progress-bar label="Sincronizando" />
    </div>

    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Tamanhos</p>
        <div class="flex flex-col gap-5">
            <smn-progress-bar value="45" size="Small" label="Small" />
            <smn-progress-bar value="45" size="Medium" label="Medium" />
            <smn-progress-bar value="45" size="Large" label="Large" />
        </div>
    </div>

    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Meter</p>
        <p class="mb-4 text-sm text-muted">
            O meter mede uma quantidade dentro de uma faixa conhecida — quota, disco, orçamento.
            Não é tarefa em andamento: para isso existe a progress bar.
        </p>
        <div class="flex flex-col gap-5">
            <smn-meter value="3.2" maximum="10" label="Armazenamento" value-text="3,2 de 10 GB" />
            <smn-meter value="8.7"
                       maximum="10"
                       color="Warning"
                       label="Quota de e-mails"
                       value-text="8.700 de 10.000" />
            <smn-meter value="9.8"
                       maximum="10"
                       color="Danger"
                       label="Limite do plano"
                       value-text="98%" />
        </div>
    </div>

    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Faixa personalizada</p>
        <smn-meter value="18" minimum="0" maximum="40" label="Horas usadas" value-text="18h de 40h" />
    </div>
</div>
