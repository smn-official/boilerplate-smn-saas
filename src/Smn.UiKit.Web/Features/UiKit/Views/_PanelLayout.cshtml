@model ComponentViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Name;
}

@section Scripts {
    <vite-asset src="Features/UiKit/Scripts/uikit.ts"></vite-asset>
}

<div class="flex min-h-screen flex-col lg:flex-row">
    <aside class="shrink-0 border-b border-border px-4 py-6 lg:w-64 lg:border-e lg:border-b-0 lg:px-6">
        <a href="@Url.Action(nameof(UiKitController.Index), "UiKit")"
           class="mb-6 block text-sm font-semibold tracking-tight">
            Smn UiKit
        </a>

        <nav aria-label="Componentes">
            <p class="mb-2 text-xs font-medium tracking-wide text-muted uppercase">Componentes</p>
            <ul class="flex flex-row gap-1 overflow-x-auto lg:flex-col lg:overflow-visible">
                @foreach (var item in Model.Navigation)
                {
                    <li>
                        <a href="@Url.Action(item.Action, "UiKit")"
                           class="block rounded-xl px-3 py-2 text-sm whitespace-nowrap transition-colors
                                  @(item.Active
                                      ? "bg-surface font-medium text-foreground"
                                      : "text-muted hover:bg-surface-hover hover:text-foreground")"
                           @(item.Active ? "aria-current=page" : null)>
                            @item.Name
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </aside>

    <main class="min-w-0 grow px-4 py-8 sm:px-6 lg:px-10">
        <div class="mx-auto max-w-3xl">
            <header class="mb-8 flex items-start justify-between gap-4">
                <div class="min-w-0">
                    <h1 class="text-3xl font-semibold tracking-tight">@Model.Name</h1>
                    <p class="mt-2 text-muted">@Model.Description</p>
                </div>
                <smn-button variant="Outline"
                            size="Small"
                            data-theme-toggle
                            aria-label="Alternar entre tema claro e escuro">
                    Tema
                </smn-button>
            </header>

            <section class="mb-10" aria-labelledby="install-title">
                <h2 id="install-title" class="mb-3 text-xl font-semibold tracking-tight">
                    Instalação
                </h2>
                <p class="mb-3 text-sm text-muted">
                    Instale os dois pacotes e registre o assembly em
                    <code class="rounded bg-surface px-1.5 py-0.5 text-xs">Features/_ViewImports.cshtml</code>:
                </p>
                <div class="code-block mb-3" data-code-block>
                    <pre class="code-block__pre"><code data-code-source="dotnet add package Smn.UiKit&#10;npm install @@smn/uikit">dotnet add package Smn.UiKit
npm install @@smn/uikit</code></pre>
                </div>
                <div class="code-block mb-3" data-code-block>
                    <pre class="code-block__pre"><code data-code-source="@@addTagHelper *, Smn.UiKit.Components&#10;&#10;@@import &quot;@@smn/uikit/tokens.css&quot;;&#10;@@import &quot;@@smn/uikit/uikit.css&quot;;">@@addTagHelper *, Smn.UiKit.Components

@@import "@@smn/uikit/tokens.css";
@@import "@@smn/uikit/uikit.css";</code></pre>
                </div>
                <p class="mb-3 text-sm text-muted">
                    O CSS vem do npm porque o Tailwind precisa enxergar o arquivo em disco para
                    fazer tree-shaking. A ordem do <code class="rounded bg-surface px-1.5 py-0.5 text-xs">@@import</code>
                    é obrigatória — <code class="rounded bg-surface px-1.5 py-0.5 text-xs">tokens.css</code>
                    declara o que <code class="rounded bg-surface px-1.5 py-0.5 text-xs">uikit.css</code> consome.
                    Passo a passo completo, com autenticação no registry privado, em
                    <code class="rounded bg-surface px-1.5 py-0.5 text-xs">INSTALL.md</code>.
                    Depois disso, use a tag direto na view:
                </p>
                <div class="code-block" data-code-block>
                    <button type="button"
                            class="code-block__copy"
                            data-copy-code
                            aria-label="Copiar código para a área de transferência">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                             data-copy-icon="idle">
                            <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
                            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                        </svg>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                             data-copy-icon="done" hidden>
                            <path d="M20 6 9 17l-5-5" />
                        </svg>
                    </button>
                    <pre class="code-block__pre"><code data-code-source="@Model.UsageMarkup">@RazorSyntaxHighlighter.Highlight(Model.UsageMarkup)</code></pre>
                    <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
                </div>
            </section>

            <section aria-labelledby="usage-title">
                <h2 id="usage-title" class="mb-3 text-xl font-semibold tracking-tight">Uso</h2>
                @RenderBody()
            </section>
        </div>
    </main>
</div>
