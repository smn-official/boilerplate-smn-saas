@model ComponentViewModel
@{
    Layout = "_PanelLayout";
}

@{
    const string campoNumericoCodigo =
"""
<smn-number-field name="quantidade"
                  label="Quantidade"
                  value="1"
                  minimum="1"
                  maximum="99" />

<smn-number-field name="usuarios-extra"
                  label="Usuários adicionais"
                  value="5"
                  minimum="0"
                  maximum="50"
                  step="5"
                  description="Cobrados à parte, de 5 em 5." />

<smn-number-field name="numero-invalido"
                  label="Com erro"
                  value="0"
                  minimum="1"
                  error="A quantidade mínima é 1." />

<smn-number-field name="numero-desabilitado"
                  label="Desabilitado"
                  value="3"
                  disabled="true" />
""";

    const string campoBuscaCodigo =
"""
<smn-search-field name="busca" placeholder="Buscar faturas…" />

<smn-search-field name="busca-com-rotulo"
                  label="Buscar clientes"
                  placeholder="Nome ou CNPJ"
                  description="Busca por parte do nome também funciona." />

<smn-search-field name="busca-preenchida" value="Acme" placeholder="Buscar…" />
""";

    const string fieldsetCodigo =
"""
<smn-fieldset legend="Endereço de cobrança"
              description="Aparece na nota fiscal.">
    <smn-input name="logradouro" label="Logradouro" />
    <div class="grid grid-cols-2 gap-4">
        <smn-input name="numero" label="Número" />
        <smn-input name="complemento" label="Complemento" />
    </div>
    <smn-select name="uf" label="UF">
        <option value="">Selecione…</option>
        <option value="sp">SP</option>
        <option value="rj">RJ</option>
    </smn-select>
</smn-fieldset>
""";
}

<div class="flex flex-col gap-6">
    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Campo numérico</p>
        <p class="mb-4 text-sm text-muted">
            As setas nativas do <code class="rounded bg-surface-secondary px-1.5 py-0.5 text-xs">type="number"</code>
            são pequenas demais e somem em alguns navegadores, então ficam escondidas e os botões do
            componente entram no lugar. Eles usam
            <code class="rounded bg-surface-secondary px-1.5 py-0.5 text-xs">stepUp()</code> e
            <code class="rounded bg-surface-secondary px-1.5 py-0.5 text-xs">stepDown()</code>, que
            já respeitam <code class="rounded bg-surface-secondary px-1.5 py-0.5 text-xs">min</code>,
            <code class="rounded bg-surface-secondary px-1.5 py-0.5 text-xs">max</code> e
            <code class="rounded bg-surface-secondary px-1.5 py-0.5 text-xs">step</code>.
        </p>
        <div class="flex max-w-xs flex-col gap-5">
            <smn-number-field name="quantidade"
                              label="Quantidade"
                              value="1"
                              minimum="1"
                              maximum="99" />

            <smn-number-field name="usuarios-extra"
                              label="Usuários adicionais"
                              value="5"
                              minimum="0"
                              maximum="50"
                              step="5"
                              description="Cobrados à parte, de 5 em 5." />

            <smn-number-field name="numero-invalido"
                              label="Com erro"
                              value="0"
                              minimum="1"
                              error="A quantidade mínima é 1." />

            <smn-number-field name="numero-desabilitado"
                              label="Desabilitado"
                              value="3"
                              disabled="true" />
        </div>
        @await Html.PartialAsync("_Codigo", campoNumericoCodigo)
    </div>

    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Campo de busca</p>
        <p class="mb-4 text-sm text-muted">
            Usa <code class="rounded bg-surface-secondary px-1.5 py-0.5 text-xs">type="search"</code>,
            então o navegador e o celular tratam como caixa de busca. O botão de limpar só aparece
            quando há algo escrito — digite para ver.
        </p>
        <div class="flex max-w-sm flex-col gap-5">
            <smn-search-field name="busca" placeholder="Buscar faturas…" />

            <smn-search-field name="busca-com-rotulo"
                              label="Buscar clientes"
                              placeholder="Nome ou CNPJ"
                              description="Busca por parte do nome também funciona." />

            <smn-search-field name="busca-preenchida" value="Acme" placeholder="Buscar…" />
        </div>
        @await Html.PartialAsync("_Codigo", campoBuscaCodigo)
    </div>

    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Fieldset</p>
        <p class="mb-4 text-sm text-muted">
            Agrupa campos relacionados sob uma legenda. O leitor de tela anuncia a legenda ao entrar
            no grupo, então o usuário sabe a que aqueles campos se referem.
        </p>
        <div class="max-w-sm">
            <smn-fieldset legend="Endereço de cobrança"
                          description="Aparece na nota fiscal.">
                <smn-input name="logradouro" label="Logradouro" />
                <div class="grid grid-cols-2 gap-4">
                    <smn-input name="numero" label="Número" />
                    <smn-input name="complemento" label="Complemento" />
                </div>
                <smn-select name="uf" label="UF">
                    <option value="">Selecione…</option>
                    <option value="sp">SP</option>
                    <option value="rj">RJ</option>
                </smn-select>
            </smn-fieldset>
        </div>
        @await Html.PartialAsync("_Codigo", fieldsetCodigo)
    </div>
</div>
