@model string
@*
    O código que produziu o exemplo logo acima, recolhido e com botão de copiar.
    Fica fechado para o olho bater primeiro no resultado; quem quer replicar abre.
*@

<details class="exemplo__codigo">
    <summary class="exemplo__resumo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
             class="exemplo__seta">
            <path d="m6 9 6 6 6-6" />
        </svg>
        Ver código
    </summary>

    <div class="code-block mt-3" data-code-block>
        <button type="button"
                class="code-block__copy"
                data-copy-code
                aria-label="Copiar o código deste exemplo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                 data-copy-icon="idle">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
            </svg>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                 data-copy-icon="done" hidden>
                <path d="M20 6 9 17l-5-5" />
            </svg>
        </button>
        <pre class="code-block__pre"><code data-code-source="@Model">@RazorSyntaxHighlighter.Highlight(Model)</code></pre>
        <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
    </div>
</details>
