@model ComponentViewModel
@{
    Layout = "_PanelLayout";
}

<div class="flex flex-col gap-6">
    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Trilha completa</p>
        <smn-breadcrumbs>
            <smn-breadcrumb href="/">Início</smn-breadcrumb>
            <smn-breadcrumb href="/clientes">Clientes</smn-breadcrumb>
            <smn-breadcrumb href="/clientes/42">Acme Ltda</smn-breadcrumb>
            <smn-breadcrumb current="true">Faturas</smn-breadcrumb>
        </smn-breadcrumbs>
    </div>

    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Dois níveis</p>
        <smn-breadcrumbs>
            <smn-breadcrumb href="/">Início</smn-breadcrumb>
            <smn-breadcrumb current="true">Configurações</smn-breadcrumb>
        </smn-breadcrumbs>
    </div>

    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Estado vazio</p>
        <p class="mb-4 text-sm text-muted">
            O estado vazio diz o que aconteceu e o que dá para fazer a respeito. Uma listagem vazia
            sem explicação parece defeito.
        </p>
        <div class="rounded-2xl bg-surface-secondary">
            <smn-empty-state title="Nenhuma fatura por aqui">
                <p>As faturas aparecem assim que a primeira cobrança for gerada.</p>
                <smn-button variant="Outline" size="Small" class="mt-2">Criar cobrança</smn-button>
            </smn-empty-state>
        </div>
    </div>

    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Vazio por busca</p>
        <div class="rounded-2xl bg-surface-secondary">
            <smn-empty-state title="Nada encontrado para “xyz”">
                <p>Tente outro termo ou limpe os filtros.</p>
            </smn-empty-state>
        </div>
    </div>
</div>
