@model ComponentViewModel
@{
    Layout = "_PanelLayout";
}

<div class="flex flex-col gap-6">
    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Campo completo</p>
        <p class="mb-4 text-sm text-muted">
            O componente monta rótulo, controle, descrição e erro já amarrados: o
            <code class="rounded bg-surface-secondary px-1.5 py-0.5 text-xs">for</code> do rótulo, o
            <code class="rounded bg-surface-secondary px-1.5 py-0.5 text-xs">aria-describedby</code>
            apontando para a descrição e para o erro, e o
            <code class="rounded bg-surface-secondary px-1.5 py-0.5 text-xs">aria-invalid</code> no
            controle. É o que costuma faltar em formulário escrito à mão.
        </p>
        <div class="max-w-sm">
            <smn-input name="email"
                       type="email"
                       label="E-mail"
                       placeholder="voce@empresa.com.br"
                       description="Usamos só para enviar o recibo."
                       required="true" />
        </div>
    </div>

    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Estados</p>
        <div class="flex max-w-sm flex-col gap-5">
            <smn-input name="normal" label="Normal" placeholder="Digite aqui" />
            <smn-input name="invalido"
                       label="Com erro"
                       value="não-é-um-email"
                       error="Informe um e-mail válido." />
            <smn-input name="desabilitado"
                       label="Desabilitado"
                       value="Não editável"
                       disabled="true" />
            <smn-input name="somente-leitura"
                       label="Somente leitura"
                       value="Valor fixo"
                       read-only="true"
                       description="Dá para copiar, mas não editar." />
        </div>
    </div>

    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Variantes</p>
        <div class="flex max-w-sm flex-col gap-5">
            <smn-input name="primary" label="Primary" placeholder="Com sombra" />
            <smn-input name="secondary"
                       variant="Secondary"
                       label="Secondary"
                       placeholder="Fundo sólido, sem sombra" />
        </div>
    </div>

    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Tipos</p>
        <div class="flex max-w-sm flex-col gap-5">
            <smn-input name="senha" type="password" label="Senha" placeholder="••••••••" />
            <smn-input name="valor" type="number" label="Quantidade" value="1" />
            <smn-input name="quando" type="date" label="Vencimento" />
            <smn-input name="busca" type="search" label="Busca" placeholder="Procurar…" />
        </div>
    </div>

    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Textarea</p>
        <div class="flex max-w-sm flex-col gap-5">
            <smn-textarea name="observacao"
                          label="Observação"
                          placeholder="Conte o que aconteceu"
                          description="Máximo de 500 caracteres."
                          rows="4" />
            <smn-textarea name="obrigatorio"
                          label="Justificativa"
                          error="A justificativa é obrigatória."
                          rows="3" />
        </div>
    </div>
</div>
