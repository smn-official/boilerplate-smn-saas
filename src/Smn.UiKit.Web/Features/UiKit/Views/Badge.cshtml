@model ComponentViewModel
@{
    Layout = "_PanelLayout";
}

<div class="flex flex-col gap-6">
    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Cores</p>
        <div class="flex flex-wrap items-center gap-3">
            <smn-badge color="Default">8</smn-badge>
            <smn-badge color="Accent">8</smn-badge>
            <smn-badge color="Success">8</smn-badge>
            <smn-badge color="Warning">8</smn-badge>
            <smn-badge color="Danger">8</smn-badge>
        </div>
    </div>

    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Variantes</p>
        <div class="flex flex-col gap-3">
            <div class="flex flex-wrap items-center gap-3">
                <smn-badge variant="Primary" color="Accent">12</smn-badge>
                <smn-badge variant="Primary" color="Success">12</smn-badge>
                <smn-badge variant="Primary" color="Warning">12</smn-badge>
                <smn-badge variant="Primary" color="Danger">12</smn-badge>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <smn-badge variant="Soft" color="Accent">12</smn-badge>
                <smn-badge variant="Soft" color="Success">12</smn-badge>
                <smn-badge variant="Soft" color="Warning">12</smn-badge>
                <smn-badge variant="Soft" color="Danger">12</smn-badge>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <smn-badge variant="Secondary" color="Accent">12</smn-badge>
                <smn-badge variant="Secondary" color="Danger">12</smn-badge>
            </div>
        </div>
    </div>

    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Tamanhos</p>
        <div class="flex flex-wrap items-center gap-3">
            <smn-badge size="Small" color="Danger">3</smn-badge>
            <smn-badge size="Medium" color="Danger">3</smn-badge>
            <smn-badge size="Large" color="Danger">3</smn-badge>
        </div>
    </div>

    <div class="rounded-2xl bg-surface p-6 shadow-surface">
        <p class="mb-4 text-xs font-medium tracking-wide text-muted uppercase">Ancorado</p>
        <p class="mb-4 text-sm text-muted">
            Para fixar o badge num canto, envolva o elemento decorado em
            <code class="rounded bg-surface-secondary px-1.5 py-0.5 text-xs">&lt;smn-badge-anchor&gt;</code>
            e informe <code class="rounded bg-surface-secondary px-1.5 py-0.5 text-xs">placement</code>.
            Sem a âncora o badge não tem contexto de posicionamento e escapa do elemento.
        </p>
        <div class="flex flex-wrap items-center gap-6">
            <smn-badge-anchor>
                <smn-avatar initials="VA" color="Accent" variant="Soft"></smn-avatar>
                <smn-badge placement="TopRight" size="Small" color="Danger">5</smn-badge>
            </smn-badge-anchor>
            <smn-badge-anchor>
                <smn-avatar initials="MK" color="Success" variant="Soft"></smn-avatar>
                <smn-badge placement="BottomRight" size="Small" color="Success">&nbsp;</smn-badge>
            </smn-badge-anchor>
            <smn-badge-anchor>
                <smn-button variant="Outline" size="Small">Notificações</smn-button>
                <smn-badge placement="TopRight" size="Small" color="Accent">9</smn-badge>
            </smn-badge-anchor>
        </div>
    </div>
</div>
