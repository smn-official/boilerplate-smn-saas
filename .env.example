# Copie para .env e preencha. O .env é ignorado pelo git; este arquivo, não.
# Nenhum valor real entra aqui — só a forma esperada.
#
# REGRA: o .env guarda SEGREDO e o que varia por MÁQUINA.
# Configuração de aplicação (rota, timeout, feature flag, nível de log)
# vai no appsettings.json, versionada. Ver .ai/docs/configuracao.md.

# ---------------------------------------------------------------
# Ferramenta de desenvolvimento — SCREAMING_SNAKE_CASE
# Lida por processo externo (MCP, CLI, script), não pelo .NET.
# ---------------------------------------------------------------

# Servidor MCP postgres (.ai/mcp/servers.json).
# Serve a container e a servidor: muda a URL, não a configuração.
# SEMPRE banco de desenvolvimento ou cópia anonimizada — nunca produção.
POSTGRES_CONNECTION_STRING=postgresql://usuario:senha@localhost:5432/banco
# Servidor remoto exige TLS:
# POSTGRES_CONNECTION_STRING=postgresql://usuario:senha@host:5432/banco?sslmode=require

# ---------------------------------------------------------------
# Runtime .NET — nomes reservados, SCREAMING_SNAKE_CASE
# Definidos pela plataforma; o nome não é escolha nossa.
# ---------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# ---------------------------------------------------------------
# Configuração .NET — espelha a chave do appsettings.json
# Formato: Secao__Chave (dois underscores = um nível de hierarquia).
# Maiúsculas e minúsculas seguem o JSON exatamente.
# Só entra aqui o que for SEGREDO; o resto fica no appsettings.json.
# ---------------------------------------------------------------

# { "ConnectionStrings": { "Default": "..." } }
ConnectionStrings__Default=Host=localhost;Port=5432;Database=banco;Username=usuario;Password=senha;SSL Mode=Prefer

# { "ApplicationInsights": { "ConnectionString": "..." } }
# Obrigatório no stack, conforme AGENTS.md.
ApplicationInsights__ConnectionString=

# { "Email": { "Senha": "..." } }
# SÓ a senha do SMTP entra aqui. Host, porta, remetente e Enabled ficam no
# appsettings.json — ver .ai/skills/email-transacional/SKILL.md.
# Sem credencial, o envio cai no fallback desabilitado e o fluxo local continua.
Email__Senha=

# Stripe — como obter cada valor: .ai/skills/stripe-credenciais/SKILL.md
# Em desenvolvimento use SEMPRE chave de teste (sk_test_/pk_test_).
# sk_live_ aqui gera cobrança real.
Stripe__SecretKey=sk_test_
Stripe__PublishableKey=pk_test_
# Do `stripe listen` em dev; do endpoint do dashboard em produção. São diferentes.
Stripe__WebhookSecret=whsec_
