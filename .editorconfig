# Convenções deste repositório, em formato que IDE, `dotnet format` e os
# analisadores do compilador entendem. A fonte normativa continua sendo o
# AGENTS.md; aqui elas viram verificação, não recomendação.
#
# `EnforceCodeStyleInBuild` está ligado no Directory.Build.props, então as
# regras marcadas como `warning` quebram o build — `TreatWarningsAsErrors`
# transforma aviso em erro.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{cs,csx}]
indent_size = 4

# --------------------------------------------------------------------------
# C# — organização de using
# --------------------------------------------------------------------------
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# --------------------------------------------------------------------------
# C# — estilo de linguagem
# --------------------------------------------------------------------------
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_var_elsewhere = false:silent
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:silent

# Padrões que sustentam a regra de early return e guarda do AGENTS.md.
csharp_style_prefer_pattern_matching = true:warning
csharp_style_prefer_not_pattern = true:warning
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:warning

# --------------------------------------------------------------------------
# C# — imutabilidade
# "Propriedades somente leitura em classes novas" (AGENTS.md)
# --------------------------------------------------------------------------
dotnet_style_readonly_field = true:warning
csharp_prefer_static_local_function = true:suggestion
csharp_style_prefer_readonly_struct = true:suggestion

# --------------------------------------------------------------------------
# Nomenclatura
# --------------------------------------------------------------------------
dotnet_naming_rule.tipos_em_pascal_case.severity = warning
dotnet_naming_rule.tipos_em_pascal_case.symbols = tipos
dotnet_naming_rule.tipos_em_pascal_case.style = pascal_case

dotnet_naming_symbols.tipos.applicable_kinds = class,struct,interface,enum,delegate
dotnet_naming_symbols.tipos.applicable_accessibilities = *

dotnet_naming_rule.interface_com_i.severity = warning
dotnet_naming_rule.interface_com_i.symbols = interfaces
dotnet_naming_rule.interface_com_i.style = prefixo_i

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_rule.campo_privado_com_underscore.severity = warning
dotnet_naming_rule.campo_privado_com_underscore.symbols = campos_privados
dotnet_naming_rule.campo_privado_com_underscore.style = prefixo_underscore

dotnet_naming_symbols.campos_privados.applicable_kinds = field
dotnet_naming_symbols.campos_privados.applicable_accessibilities = private

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.prefixo_i.required_prefix = I
dotnet_naming_style.prefixo_i.capitalization = pascal_case
dotnet_naming_style.prefixo_underscore.required_prefix = _
dotnet_naming_style.prefixo_underscore.capitalization = camel_case

# --------------------------------------------------------------------------
# Analisadores — o que quebra o build
# --------------------------------------------------------------------------
# CancellationToken como último parâmetro é regra do AGENTS.md; CA1068 a verifica.
dotnet_diagnostic.CA1068.severity = error

# ConfigureAwait, comparação de string por cultura e Dispose não chamado.
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA2000.severity = warning

# Chamada síncrona de método assíncrono e async sem await.
dotnet_diagnostic.CS4014.severity = error
dotnet_diagnostic.CS1998.severity = warning

# using desnecessário e variável não usada: ruído que esconde problema real.
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0059.severity = warning

# CA1822 ("pode ser estático") dispara em todo método de serviço que ainda não
# usa estado da instância — o que é normal enquanto a implementação cresce.
# Como aviso é erro aqui, mantê-lo ligado quebraria o build por estilo e ensinaria
# a suprimir analisador, que é o hábito que este arquivo existe para evitar.
dotnet_diagnostic.CA1822.severity = suggestion

# Idem para "declare como const": correção mecânica, não defeito.
dotnet_diagnostic.IDE0044.severity = suggestion

# --------------------------------------------------------------------------
# Front-end e configuração
# --------------------------------------------------------------------------
[*.{ts,js,mjs}]
indent_size = 2
max_line_length = 100
quote_type = double

[*.{json,jsonc,yml,yaml}]
indent_size = 2

[*.cshtml]
indent_size = 4

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.sql]
indent_size = 4

[*.md]
# Markdown usa dois espaços no fim da linha para quebra deliberada.
trim_trailing_whitespace = false
