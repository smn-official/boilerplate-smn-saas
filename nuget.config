<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      Feed privado do design system. A credencial NÃO mora aqui: registre-a no
      NuGet.Config do usuário rodando "dotnet nuget update source smn" com as
      flags de username e password, conforme o INSTALL.md do smn-uikit.

      Rode esse comando SEM a flag de configfile. Com ela, o token é gravado em
      texto claro NESTE arquivo, que é versionado.
    -->
    <add key="smn" value="https://nuget.pkg.github.com/Vagnerking/index.json" />
  </packageSources>

  <!--
    Sem este mapeamento o NuGet consulta todas as fontes para todo pacote, e um
    pacote público chamado Smn.* poderia ser resolvido no lugar do nosso
    (dependency confusion).
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="smn">
      <package pattern="Smn.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
